# Copy to .env (or run `npm run import-apis` to build it from ../apis.txt).
# Every sponsor is optional: a missing key switches that piece to its local fallback.

# ---- Anchor Browser (cloud browser that clicks the key flows) ----
ANCHOR_API_KEY=

# ---- Daytona (sandboxes that reproduce + verify fixes) ----
DAYTONA_API_KEY=
DAYTONA_API_URL=https://app.daytona.io/api
DAYTONA_TARGET=us

# ---- AWS (Bedrock for Claude + embeddings + guardrails; S3 for hosting the store) ----
AWS_REGION=us-west-2
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_SESSION_TOKEN=
BEDROCK_GUARDRAIL_ID=
BEDROCK_GUARDRAIL_VERSION=DRAFT
HEALOPS_S3_BUCKET=

# ---- Anthropic API (optional, used only if Bedrock is unavailable) ----
ANTHROPIC_API_KEY=

# ---- SurrealDB (agent memory: graph + vectors). Empty URL = embedded in-memory engine ----
SURREAL_URL=
SURREAL_NAMESPACE=healops
SURREAL_DATABASE=agent
SURREAL_USER=
SURREAL_PASS=
# database token (JWT) for SURREAL_URL; NOT the sdbp_ cloud token
SURREAL_TOKEN=
# Surreal Cloud personal access token (sdbp_…): control plane only (list instances / endpoint)
SURREAL_CLOUD_TOKEN=

# ---- Arize (OpenTelemetry traces + evals) ----
ARIZE_SPACE_ID=
ARIZE_API_KEY=
ARIZE_PROJECT_NAME=healops

# ---- HealOps ----
# auto | bedrock | anthropic | offline
HEALOPS_LLM_PROVIDER=auto
# Defaults: claude-opus-5-5 for patches, claude-haiku-5-5 for judge/triage/screening
# (Bedrock gets the "anthropic." prefix automatically).
HEALOPS_PATCH_MODEL=
HEALOPS_JUDGE_MODEL=
# observe | suggest | auto_low | full
HEALOPS_AUTONOMY=auto_low
HEALOPS_RISK_THRESHOLD=50
HEALOPS_PATROL_INTERVAL_SEC=120
HEALOPS_SERVER_PORT=8787
HEALOPS_STORE_PORT=4000
HEALOPS_PUBLIC_API_URL=http://localhost:8787
# Public URL for the store (e.g. from `npm run tunnel`) so Anchor's cloud browser can reach it.
HEALOPS_PUBLIC_STORE_URL=
